# ─────────────────────────────────────────────────────────────────────────────
# next-betterAuth-multiservice-template - Environment Variables
# One file at the repo root, loaded by every app and package.
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_APP_ENV=development

# Public URLs of each service
NEXT_PUBLIC_ACCOUNTS_URL=http://localhost:5011
NEXT_PUBLIC_WEB_URL=http://localhost:5010

# One database per service (created by docker/postgres/init.sql)
ACCOUNTS_DATABASE_URL=postgresql://postgres:postgres@localhost:5000/accounts_db
WEB_DATABASE_URL=postgresql://postgres:postgres@localhost:5000/web_db

# Better Auth secrets, one per service (generate with `openssl rand -base64 32`)
ACCOUNTS_AUTH_SECRET=change-me-accounts-secret-at-least-32-chars
WEB_AUTH_SECRET=change-me-web-secret-at-least-32-chars-long

# OAuth client that `web` uses to sign in through `accounts`.
# `pnpm db:seed` registers it in accounts_db with these values.
WEB_OAUTH_CLIENT_ID=web
WEB_OAUTH_CLIENT_SECRET=change-me-web-oauth-client-secret-32-chars

# Message broker (accounts publishes email jobs, worker consumes them)
RABBITMQ_URL=amqp://guest:guest@localhost:5001

# Worker
WORKER_PORT=5012
SMTP_HOST=localhost
SMTP_PORT=5003
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Next BetterAuth <no-reply@localhost>"
