# ─────────────────────────────────────────────────────────────────────────────
# next-tanstack-framework-template - Environment Variables
# One file at the repo root, loaded by every app and package.
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_APP_ENV=development

# Public URLs of each service
NEXT_PUBLIC_ACCOUNTS_URL=http://localhost:5011
NEXT_PUBLIC_HR_URL=http://localhost:5010
NEXT_PUBLIC_FINANCE_URL=http://localhost:5013
NEXT_PUBLIC_RECRUITMENT_URL=http://localhost:5014
NEXT_PUBLIC_ATTENDANCE_URL=http://localhost:5015
NEXT_PUBLIC_EXAM_URL=http://localhost:5016
NEXT_PUBLIC_CRM_URL=http://localhost:5017
NEXT_PUBLIC_OPERATIONS_URL=http://localhost:5018
NEXT_PUBLIC_ANALYTICS_URL=http://localhost:5019
NEXT_PUBLIC_COLLABORATION_URL=http://localhost:5020
NEXT_PUBLIC_WORKSPACE_URL=http://localhost:5021

# One database per service (D17): accounts_db for identity, <app>_db per domain, each
# reachable only by its own role (docker/postgres/init.sql). <app>_shadow is only used
# by `prisma migrate dev`.
ACCOUNTS_DATABASE_URL=postgresql://postgres:postgres@localhost:5000/accounts_db
HR_DATABASE_URL=postgresql://hr_app:hr_pw@localhost:5000/hr_db
HR_SHADOW_DATABASE_URL=postgresql://hr_app:hr_pw@localhost:5000/hr_shadow
FINANCE_DATABASE_URL=postgresql://finance_app:finance_pw@localhost:5000/finance_db
FINANCE_SHADOW_DATABASE_URL=postgresql://finance_app:finance_pw@localhost:5000/finance_shadow
RECRUITMENT_DATABASE_URL=postgresql://recruitment_app:recruitment_pw@localhost:5000/recruitment_db
RECRUITMENT_SHADOW_DATABASE_URL=postgresql://recruitment_app:recruitment_pw@localhost:5000/recruitment_shadow
ATTENDANCE_DATABASE_URL=postgresql://attendance_app:attendance_pw@localhost:5000/attendance_db
ATTENDANCE_SHADOW_DATABASE_URL=postgresql://attendance_app:attendance_pw@localhost:5000/attendance_shadow
EXAM_DATABASE_URL=postgresql://exam_app:exam_pw@localhost:5000/exam_db
EXAM_SHADOW_DATABASE_URL=postgresql://exam_app:exam_pw@localhost:5000/exam_shadow
CRM_DATABASE_URL=postgresql://crm_app:crm_pw@localhost:5000/crm_db
CRM_SHADOW_DATABASE_URL=postgresql://crm_app:crm_pw@localhost:5000/crm_shadow
OPERATIONS_DATABASE_URL=postgresql://operations_app:operations_pw@localhost:5000/operations_db
OPERATIONS_SHADOW_DATABASE_URL=postgresql://operations_app:operations_pw@localhost:5000/operations_shadow
ANALYTICS_DATABASE_URL=postgresql://analytics_app:analytics_pw@localhost:5000/analytics_db
ANALYTICS_SHADOW_DATABASE_URL=postgresql://analytics_app:analytics_pw@localhost:5000/analytics_shadow
COLLABORATION_DATABASE_URL=postgresql://collaboration_app:collaboration_pw@localhost:5000/collaboration_db
COLLABORATION_SHADOW_DATABASE_URL=postgresql://collaboration_app:collaboration_pw@localhost:5000/collaboration_shadow
WORKSPACE_DATABASE_URL=postgresql://workspace_app:workspace_pw@localhost:5000/workspace_db
WORKSPACE_SHADOW_DATABASE_URL=postgresql://workspace_app:workspace_pw@localhost:5000/workspace_shadow

# Better Auth secrets, one per service (generate with `openssl rand -base64 32`)
ACCOUNTS_AUTH_SECRET=change-me-accounts-secret-at-least-32-chars
HR_AUTH_SECRET=change-me-hr-secret-at-least-32-chars-long-x
FINANCE_AUTH_SECRET=change-me-finance-secret-at-least-32-chars-long
RECRUITMENT_AUTH_SECRET=change-me-recruitment-secret-at-least-32-chars-long
ATTENDANCE_AUTH_SECRET=change-me-attendance-secret-at-least-32-chars-long
EXAM_AUTH_SECRET=change-me-exam-secret-at-least-32-chars-long
CRM_AUTH_SECRET=change-me-crm-secret-at-least-32-chars-long
OPERATIONS_AUTH_SECRET=change-me-operations-secret-at-least-32-chars-long
ANALYTICS_AUTH_SECRET=change-me-analytics-secret-at-least-32-chars-long
COLLABORATION_AUTH_SECRET=change-me-collaboration-secret-at-least-32-chars-long
WORKSPACE_AUTH_SECRET=change-me-workspace-secret-at-least-32-chars-long

# OAuth clients the domain apps use to sign in through `accounts`.
# `pnpm db:seed` registers it in accounts_db with these values.
HR_OAUTH_CLIENT_ID=hr
HR_OAUTH_CLIENT_SECRET=change-me-hr-oauth-client-secret-32-chars-x
FINANCE_OAUTH_CLIENT_ID=finance
FINANCE_OAUTH_CLIENT_SECRET=change-me-finance-oauth-client-secret-32-chars
RECRUITMENT_OAUTH_CLIENT_ID=recruitment
RECRUITMENT_OAUTH_CLIENT_SECRET=change-me-recruitment-oauth-client-secret-32-chars
ATTENDANCE_OAUTH_CLIENT_ID=attendance
ATTENDANCE_OAUTH_CLIENT_SECRET=change-me-attendance-oauth-client-secret-32-chars
EXAM_OAUTH_CLIENT_ID=exam
EXAM_OAUTH_CLIENT_SECRET=change-me-exam-oauth-client-secret-32-chars
CRM_OAUTH_CLIENT_ID=crm
CRM_OAUTH_CLIENT_SECRET=change-me-crm-oauth-client-secret-32-chars
OPERATIONS_OAUTH_CLIENT_ID=operations
OPERATIONS_OAUTH_CLIENT_SECRET=change-me-operations-oauth-client-secret-32-chars
ANALYTICS_OAUTH_CLIENT_ID=analytics
ANALYTICS_OAUTH_CLIENT_SECRET=change-me-analytics-oauth-client-secret-32-chars
COLLABORATION_OAUTH_CLIENT_ID=collaboration
COLLABORATION_OAUTH_CLIENT_SECRET=change-me-collaboration-oauth-client-secret-32-chars
WORKSPACE_OAUTH_CLIENT_ID=workspace
WORKSPACE_OAUTH_CLIENT_SECRET=change-me-workspace-oauth-client-secret-32-chars

# Message broker (accounts publishes email jobs, worker consumes them)
RABBITMQ_URL=amqp://guest:guest@localhost:5001

# Worker
WORKER_PORT=5012
SMTP_HOST=localhost
SMTP_PORT=5003
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Next TanStack Template <no-reply@localhost>"
