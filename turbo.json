{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": [".env"],
  "globalEnv": [
    "NODE_ENV",
    "NEXT_PUBLIC_APP_ENV",
    "NEXT_PUBLIC_ACCOUNTS_URL",
    "NEXT_PUBLIC_WEB_URL",
    "ACCOUNTS_DATABASE_URL",
    "WEB_DATABASE_URL",
    "ACCOUNTS_AUTH_SECRET",
    "WEB_AUTH_SECRET",
    "WEB_OAUTH_CLIENT_ID",
    "WEB_OAUTH_CLIENT_SECRET",
    "RABBITMQ_URL"
  ],
  "tasks": {
    "db:generate": { "cache": false },
    "db:migrate": { "cache": false, "persistent": true },
    "db:deploy": { "cache": false },
    "db:seed": { "cache": false, "dependsOn": ["db:deploy"] },
    "build": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "type-check": { "dependsOn": ["db:generate"] },
    "lint": {},
    "dev": { "cache": false, "persistent": true, "dependsOn": ["db:generate"] },
    "start": { "cache": false, "persistent": true }
  }
}
