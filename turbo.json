{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "concurrency": "20",
  "globalDependencies": [".env"],
  "globalEnv": [
    "NODE_ENV",
    "NEXT_PUBLIC_APP_ENV",
    "NEXT_PUBLIC_ACCOUNTS_URL",
    "NEXT_PUBLIC_PEOPLE_URL",
    "PEOPLE_DATABASE_URL",
    "PEOPLE_SHADOW_DATABASE_URL",
    "PEOPLE_AUTH_SECRET",
    "PEOPLE_OAUTH_CLIENT_ID",
    "PEOPLE_OAUTH_CLIENT_SECRET",
    "NEXT_PUBLIC_HR_URL",
    "ACCOUNTS_DATABASE_URL",
    "HR_DATABASE_URL",
    "HR_SHADOW_DATABASE_URL",
    "ACCOUNTS_AUTH_SECRET",
    "HR_AUTH_SECRET",
    "HR_OAUTH_CLIENT_ID",
    "HR_OAUTH_CLIENT_SECRET",
    "NEXT_PUBLIC_FINANCE_URL",
    "FINANCE_DATABASE_URL",
    "FINANCE_SHADOW_DATABASE_URL",
    "FINANCE_AUTH_SECRET",
    "FINANCE_OAUTH_CLIENT_ID",
    "FINANCE_OAUTH_CLIENT_SECRET",
    "NEXT_PUBLIC_RECRUITMENT_URL",
    "RECRUITMENT_DATABASE_URL",
    "RECRUITMENT_SHADOW_DATABASE_URL",
    "RECRUITMENT_AUTH_SECRET",
    "RECRUITMENT_OAUTH_CLIENT_ID",
    "RECRUITMENT_OAUTH_CLIENT_SECRET",
    "NEXT_PUBLIC_ATTENDANCE_URL",
    "ATTENDANCE_DATABASE_URL",
    "ATTENDANCE_SHADOW_DATABASE_URL",
    "ATTENDANCE_AUTH_SECRET",
    "ATTENDANCE_OAUTH_CLIENT_ID",
    "ATTENDANCE_OAUTH_CLIENT_SECRET",
    "NEXT_PUBLIC_EXAM_URL",
    "EXAM_DATABASE_URL",
    "EXAM_SHADOW_DATABASE_URL",
    "EXAM_AUTH_SECRET",
    "EXAM_OAUTH_CLIENT_ID",
    "EXAM_OAUTH_CLIENT_SECRET",
    "NEXT_PUBLIC_CRM_URL",
    "CRM_DATABASE_URL",
    "CRM_SHADOW_DATABASE_URL",
    "CRM_AUTH_SECRET",
    "CRM_OAUTH_CLIENT_ID",
    "CRM_OAUTH_CLIENT_SECRET",
    "NEXT_PUBLIC_OPERATIONS_URL",
    "OPERATIONS_DATABASE_URL",
    "OPERATIONS_SHADOW_DATABASE_URL",
    "OPERATIONS_AUTH_SECRET",
    "OPERATIONS_OAUTH_CLIENT_ID",
    "OPERATIONS_OAUTH_CLIENT_SECRET",
    "NEXT_PUBLIC_ANALYTICS_URL",
    "ANALYTICS_DATABASE_URL",
    "ANALYTICS_SHADOW_DATABASE_URL",
    "ANALYTICS_AUTH_SECRET",
    "ANALYTICS_OAUTH_CLIENT_ID",
    "ANALYTICS_OAUTH_CLIENT_SECRET",
    "NEXT_PUBLIC_COLLABORATION_URL",
    "COLLABORATION_DATABASE_URL",
    "COLLABORATION_SHADOW_DATABASE_URL",
    "COLLABORATION_AUTH_SECRET",
    "COLLABORATION_OAUTH_CLIENT_ID",
    "COLLABORATION_OAUTH_CLIENT_SECRET",
    "NEXT_PUBLIC_WORKSPACE_URL",
    "WORKSPACE_DATABASE_URL",
    "WORKSPACE_SHADOW_DATABASE_URL",
    "WORKSPACE_AUTH_SECRET",
    "WORKSPACE_OAUTH_CLIENT_ID",
    "WORKSPACE_OAUTH_CLIENT_SECRET",
    "RABBITMQ_URL",
    "WORKER_PORT",
    "SMTP_HOST",
    "SMTP_PORT",
    "SMTP_USER",
    "SMTP_PASS",
    "SMTP_FROM"
  ],
  "tasks": {
    "db:generate": { "cache": false },
    "db:migrate": { "cache": false, "persistent": true },
    "db:deploy": { "cache": false },
    "db:seed": { "cache": false, "dependsOn": ["db:deploy"] },
    "build": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", ".output/**"]
    },
    "type-check": { "dependsOn": ["db:generate"] },
    "lint": {},
    "dev": { "cache": false, "persistent": true, "dependsOn": ["db:generate"] },
    "start": { "cache": false, "persistent": true }
  }
}
