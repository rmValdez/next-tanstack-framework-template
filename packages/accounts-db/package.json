{
  "name": "@workspace/accounts-db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file=../../.env prisma/seed.ts",
    "db:studio": "prisma studio",
    "auth:schema": "auth generate --config scripts/auth-schema.ts --output prisma/schema.prisma",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@workspace/core": "workspace:*",
    "pg": "^8.23.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@better-auth/oauth-provider": "1.7.7",
    "@types/node": "^20.17.19",
    "auth": "1.7.7",
    "better-auth": "1.7.7",
    "dotenv": "^17.4.2",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
