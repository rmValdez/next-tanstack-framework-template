// Finance's part of company_db. Everything here lives in the `finance` schema, which only
// finance_app can read or write. Data other domains may read goes in `finance_public` views
// (hand-written migrations, as in packages/hr-db). To read another domain's views, list its
// `_public` schema in `schemas` and declare the view (docs/decisions.md, D13).

generator client {
  provider        = "prisma-client"
  output          = "./generated"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
  // hr_public is listed only to read HR's published view. Migrations here never create or
  // change anything in it (verified in the shared-database spike).
  schemas  = ["finance", "hr_public"]
}

// ─── Domain ─────────────────────────────────────────────────────────────────

enum PayrollStatus {
  DRAFT
  APPROVED

  @@map("payroll_status")
  @@schema("finance")
}

// One employee's pay for one month.
model PayrollEntry {
  id          String        @id @default(cuid())
  // HR's employee id. No foreign key: hr.employees belongs to another owner.
  employeeId  String        @map("employee_id")
  // Calendar month, "YYYY-MM".
  period      String
  grossPay    Decimal       @map("gross_pay") @db.Decimal(12, 2)
  deductions  Decimal       @db.Decimal(12, 2)
  status      PayrollStatus @default(DRAFT)
  // finance.user id of whoever recorded it.
  createdById String        @map("created_by_id")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@unique([employeeId, period])
  @@index([period])
  @@map("payroll_entries")
  @@schema("finance")
}

// ─── Read from HR (hr_public.employee_directory_v1) ─────────────────────────
// Read-only: finance_app has SELECT only, granted by HR's migration. Pinned to _v1; when HR
// publishes _v2, switch the @@map here and redeploy before HR drops _v1.

view EmployeeDirectory {
  id             String @unique
  employeeNo     String @map("employee_no")
  fullName       String @map("full_name")
  email          String
  position       String
  departmentCode String @map("department_code")
  departmentName String @map("department_name")
  status         String

  @@map("employee_directory_v1")
  @@schema("hr_public")
}

// ─── Better Auth (Finance's own sessions) ────────────────────────────────────────
// Generated by `pnpm auth:schema` (Better Auth core; genericOAuth adds no tables), then
// tagged @@schema("finance"). After regenerating, re-add the tags and keep the domain models.
// `user` is the shadow of the accounts identity.

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
  @@schema("finance")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
  @@schema("finance")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
  @@schema("finance")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
  @@schema("finance")
}
