// People's own database (people_db). Only the people_app role can connect to it (D17, D21).
// Encapsulates the People Operations bounded context: HR, Recruitment, and Attendance.
// Other domains never read these tables directly: they call People's /api/v1 with an
// accounts-issued app token (D18), or consume its domain events (D16).

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

// ─── HR Domain ──────────────────────────────────────────────────────────────

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED

  @@map("employee_status")
}

model Department {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  employees   Employee[]
  jobOpenings JobOpening[]

  @@map("departments")
}

model Employee {
  id                String             @id @default(cuid())
  employeeNo        String             @unique @map("employee_no")
  fullName          String             @map("full_name")
  email             String             @unique
  position          String
  departmentId      String             @map("department_id")
  department        Department         @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  status            EmployeeStatus     @default(ACTIVE)
  hiredOn           DateTime           @map("hired_on") @db.Date
  // Private to People: never returned by /api/v1 (other domains get a read model without it).
  monthlySalary     Decimal            @map("monthly_salary") @db.Decimal(12, 2)
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  candidates        Candidate[]
  attendanceRecords AttendanceRecord[]

  @@index([departmentId])
  @@map("employees")
}

// ─── Recruitment Domain ─────────────────────────────────────────────────────

enum JobOpeningStatus {
  OPEN
  CLOSED

  @@map("job_opening_status")
}

model JobOpening {
  id           String           @id @default(cuid())
  title        String
  departmentId String           @map("department_id")
  department   Department       @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  status       JobOpeningStatus @default(OPEN)
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  candidates   Candidate[]

  @@index([departmentId])
  @@map("job_openings")
}

enum CandidateStatus {
  APPLIED
  SCREENING
  INTERVIEWING
  OFFERED
  HIRED
  REJECTED

  @@map("candidate_status")
}

model Candidate {
  id           String          @id @default(cuid())
  fullName     String          @map("full_name")
  email        String
  phone        String?
  jobOpeningId String          @map("job_opening_id")
  jobOpening   JobOpening      @relation(fields: [jobOpeningId], references: [id], onDelete: Restrict)
  status       CandidateStatus @default(APPLIED)
  // When a candidate is hired, the transition links to their newly created Employee record.
  // This enables atomic Candidate -> Employee creation in a single DB transaction!
  employeeId   String?         @map("employee_id")
  employee     Employee?       @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  hiredAt      DateTime?       @map("hired_at")
  notes        String?
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  @@index([jobOpeningId])
  @@index([employeeId])
  @@map("candidates")
}

// ─── Attendance Domain ──────────────────────────────────────────────────────

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  ON_LEAVE

  @@map("attendance_status")
}

model AttendanceRecord {
  id         String           @id @default(cuid())
  employeeId String           @map("employee_id")
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime         @db.Date
  checkIn    DateTime?        @map("check_in")
  checkOut   DateTime?        @map("check_out")
  status     AttendanceStatus @default(PRESENT)
  notes      String?
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  @@unique([employeeId, date])
  @@index([employeeId])
  @@map("attendance_records")
}

// ─── Better Auth (People's own sessions) ────────────────────────────────────
// Generated by `pnpm auth:schema` (Better Auth core; genericOAuth adds no tables).
// `user` is the shadow of the accounts identity; employees are a separate People record.

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
